{
  "name": "@keygrant/electron",
  "version": "0.4.0",
  "description": "KeyGrant licensing for Electron and Node desktop apps: signed leases verified offline, fail-in-favour-of-the-customer.",
  "license": "MIT",
  "author": "KeyGrant",
  "homepage": "https://keygrant.dev/docs",
  "keywords": [
    "licensing",
    "license-key",
    "software-licensing",
    "electron",
    "offline",
    "keygrant"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/types-cjs/sdk/src/index.d.ts",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/types/sdk/src/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/types-cjs/sdk/src/index.d.ts",
          "default": "./dist/index.cjs"
        }
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "prepack": "node scripts/build.mjs",
    "check:package": "node scripts/check-package.mjs",
    "prepublishOnly": "node scripts/check-package.mjs",
    "conformance": "tsx conformance/generate.ts"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@keygrant/shared": "workspace:*",
    "@types/node": "^26.4.1",
    "esbuild": "^0.25.12",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keygrantdev/keygrant-electron.git",
    "directory": "sdk"
  }
}
